# 🥷 Trading Sensei - Environment Configuration
# Copy to .env and fill in your values. Never commit .env.

# --- Core ---
PORT=5000
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
# Share this with your MT5 EA via the X-EA-Secret header.
EA_SECRET=

# --- State store ---
# Optional. If omitted, the server falls back to an in-memory store
# (state is lost on restart — fine for dev, not for prod).
REDIS_URL=

# --- OANDA (optional, for live account/trade fetch) ---
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# --- Notifications (all optional) ---
# Firebase Cloud Messaging server key for mobile push.
FIREBASE_SERVER_KEY=

# Telegram bot — create with @BotFather, get chat ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord webhook — Server Settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=
