# 🥷 Trading Sensei - Environment Configuration
# Copy to .env and fill in your values. Never commit .env.

# --- Core ---
PORT=5000
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
# Share this with your MT5 EA via the X-EA-Secret header.
EA_SECRET=

# 6-digit PIN used to bootstrap the admin user on first boot. After the user
# exists in the store, this env var is ignored — change the PIN via
# POST /api/auth/change-pin instead.
ADMIN_PIN=

# --- State store ---
# Optional. If omitted, the server falls back to an in-memory store
# (state is lost on restart — fine for dev, not for prod).
REDIS_URL=

# --- Trade history (durable closed-trade ledger) ---
# Default: sqlite:///data/trades.db. Use sqlite://:memory: for tests.
DATABASE_URL=sqlite:///data/trades.db

# --- OANDA (optional, for live account/trade fetch) ---
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# --- Notifications (all optional) ---
# Firebase Cloud Messaging server key for mobile push.
FIREBASE_SERVER_KEY=

# Telegram bot — create with @BotFather, get chat ID from @userinfobot.
# To enable inbound commands (/status, /closeall, etc), also set
# TELEGRAM_WEBHOOK_SECRET to any random string and tell Telegram about it:
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<server>/webhook/telegram/<SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Discord webhook — Server Settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=
